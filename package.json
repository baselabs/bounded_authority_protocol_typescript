{
  "name": "@bounded-authority-protocol/verifier",
  "version": "0.7.0",
  "description": "Provider-neutral, deterministic verifier SDK for bounded proof-of-possession authority — a typed TypeScript reimplementation of the Bounded Authority Protocol verification profiles (wire contract-majors 1, 2, and 3) for Node.js, browsers, Deno and Bun.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "default": "./dist/src/index.js"
    },
    "./package.json": "./package.json",
    "./dist/src/crypto/*": null,
    "./*": "./*"
  },
  "sideEffects": false,
  "imports": {
    "#crypto": {
      "bap-source": {
        "bap-portable": "./src/crypto/portable.ts",
        "default": "./src/crypto/node.ts"
      },
      "bap-portable": {
        "types": "./dist/src/crypto/backend.d.ts",
        "default": "./dist/src/crypto/portable.js"
      },
      "deno": {
        "types": "./dist/src/crypto/backend.d.ts",
        "default": "./dist/src/crypto/portable.js"
      },
      "bun": {
        "types": "./dist/src/crypto/backend.d.ts",
        "default": "./dist/src/crypto/portable.js"
      },
      "workerd": {
        "types": "./dist/src/crypto/backend.d.ts",
        "default": "./dist/src/crypto/portable.js"
      },
      "worker": {
        "types": "./dist/src/crypto/backend.d.ts",
        "default": "./dist/src/crypto/portable.js"
      },
      "node": {
        "types": "./dist/src/crypto/backend.d.ts",
        "default": "./dist/src/crypto/node.js"
      },
      "types": "./dist/src/crypto/backend.d.ts",
      "default": "./dist/src/crypto/portable.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "pack:release": "node tools/pack.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:browser": "tsc -p tsconfig.browser.json && tsc -p browser/tsconfig.json",
    "lint": "eslint .",
    "guard:browser": "node tools/browser-guard.mjs",
    "size": "pnpm build && node --test --import tsx/esm test/bundle-size.ts && node tools/bundle-size.mjs",
    "license-check": "node tools/license-check.mjs",
    "check:currency": "node tools/check-currency.mjs",
    "test": "pnpm build && node --test --conditions=bap-source --import tsx/esm test/*.test.ts",
    "test:permissiveness": "node --test --conditions=bap-source --import tsx/esm test/permissiveness.ts",
    "test:portable": "pnpm build && node --test --conditions=bap-source --conditions=bap-portable --import tsx/esm test/*.test.ts test/permissiveness.ts",
    "test:tarball": "pnpm build && node --test --import tsx/esm test/tarball.ts",
    "test:runtimes": "pnpm build && node --test --conditions=bap-source --import tsx/esm test/runtimes.ts",
    "test:browser": "pnpm build && node --test --conditions=bap-source --import tsx/esm test/browser.ts",
    "conformance": "tsx --conditions=bap-source conformance/run.ts",
    "conformance:v2": "tsx --conditions=bap-source conformance/run_v2.ts",
    "conformance:v3": "tsx --conditions=bap-source conformance/run_v3.ts",
    "conformance:role-attestation": "tsx --conditions=bap-source conformance/run_role_attestation.ts",
    "conformance:content-assertion": "tsx --conditions=bap-source conformance/run_content_assertion.ts",
    "conformance:strict-ed25519": "tsx --conditions=bap-source conformance/run_strict_ed25519.ts",
    "conformance:producer-canonicality": "tsx --conditions=bap-source conformance/run_producer_canonicality.ts",
    "conformance:local-loopback-http": "tsx --conditions=bap-source conformance/run_local_loopback_http.ts",
    "conformance:portable": "node --conditions=bap-source --conditions=bap-portable --import tsx/esm conformance/run_all.ts --backend=portable",
    "census": "tsx --conditions=bap-source conformance/census.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:site": "node web/build.mjs"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/ed25519": "3.2.0",
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@bounded-authority-protocol/signer": "^0.5.0",
    "@types/node": "^26.6.6",
    "@types/semver": "^7.8.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.1",
    "semver": "^7.8.5",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "yaml": "^2.9.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/bounded_authority_protocol_typescript.git"
  },
  "homepage": "https://github.com/baselabs/bounded_authority_protocol_typescript#readme",
  "bugs": "https://github.com/baselabs/bounded_authority_protocol_typescript/issues",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.20.0"
}
