{
  "name": "@bounded-authority-protocol/verifier",
  "version": "0.2.2",
  "description": "Provider-neutral, deterministic verifier SDK for bounded proof-of-possession authority \u2014 a typed TypeScript reimplementation of the Bounded Authority Protocol verification profiles (wire contract-majors 1 and 2).",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "license-check": "node tools/license-check.mjs",
    "check:currency": "node tools/check-currency.mjs",
    "test": "node --test --import tsx/esm test/*.test.ts",
    "test:permissiveness": "node --test --import tsx/esm test/permissiveness.ts",
    "conformance": "tsx conformance/run.ts",
    "conformance:v2": "tsx conformance/run_v2.ts",
    "census": "tsx conformance/census.ts",
    "typecheck:web": "tsc -p tsconfig.web.json",
    "build:site": "node web/build.mjs && esbuild web/main.ts --bundle --minify --format=iife --target=es2022 --outfile=site-dist/app.js --alias:node:crypto=./web/shim/node-crypto.ts --inject:./web/shim/buffer-global.ts"
  },
  "devDependencies": {
    "@bounded-authority-protocol/signer": "^0.1.2",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "^2.4.0",
    "@types/node": "^26.6.1",
    "buffer": "^6.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "semver": "^7.8.5",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/baselabs/bounded_authority_protocol_typescript.git"
  },
  "homepage": "https://github.com/baselabs/bounded_authority_protocol_typescript#readme",
  "bugs": "https://github.com/baselabs/bounded_authority_protocol_typescript/issues",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@10.20.0"
}
